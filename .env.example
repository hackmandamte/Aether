# Copy to .env for local dev, and set both as environment variables on your host.

# xAI key used server-side for chat, speech-to-text and text-to-speech. Never commit it.
XAI_API_KEY=

# Shared secret that unlocks the server functions above (min 16 chars; the server refuses
# every request without it). Generate one with:  openssl rand -base64 24
# Enter the same value once in the app: Settings tab -> Access code.
AETHER_ACCESS_CODE=
