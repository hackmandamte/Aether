# Copy to .env for local dev. Set the same values on your host (Vercel) for production.
#
# AUTH — preferred: per-device tokens (no shared code in the APK)
# Server signs device tokens with AETHER_SIGNING_SECRET (or falls back to hashing AETHER_ACCESS_CODE).
# The signing secret must NEVER be baked into the Android APK.
#
AETHER_SIGNING_SECRET=
# openssl rand -base64 32

# Legacy shared unlock (optional migration). If set, old APKs that only send this still work.
# Prefer device enrollment for new installs — users do not type this.
AETHER_ACCESS_CODE=
# openssl rand -base64 24
#
# Optional multi-code list (comma-separated), each ≥ 16 chars:
# AETHER_ACCESS_CODES=

# Which AI service: "xai" (default) or "groq"
AETHER_PROVIDER=xai

GROQ_API_KEY=
XAI_API_KEY=

# Optional model overrides
# LLM_MODEL=
# STT_MODEL=
