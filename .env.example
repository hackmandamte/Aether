# Copy to .env for local dev, and set the same values as environment variables on your host
# (Vercel / server) AND as GitHub Actions secrets for the APK build.

# Shared secret that unlocks the server (min 16 chars).
# Generate one with:  openssl rand -base64 24
#
# Deployers only — end users never type this.
# - Server: AETHER_ACCESS_CODE env var
# - APK: same value as GitHub secret AETHER_ACCESS_CODE (baked into the release APK)
# The app pulls it silently from the native bridge. There is no Settings field for it.
AETHER_ACCESS_CODE=

# Which AI service to use: "groq" (free tier, no card) or "xai" (paid, default).
AETHER_PROVIDER=groq

# Key for the provider you picked. Only the matching one is needed.
GROQ_API_KEY=
XAI_API_KEY=

# Optional: override the model if a provider retires one.
# LLM_MODEL=
# STT_MODEL=
