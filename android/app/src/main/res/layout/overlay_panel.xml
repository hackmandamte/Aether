<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the in-app glass composer: chips + rounded input + mic + send -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/eta_panel_bg"
    android:paddingTop="12dp"
    android:paddingBottom="20dp"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:elevation="16dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#44FFFFFF" />

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:text="ETA"
            android:textColor="#F7F9FC"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/overlay_dismiss"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="×"
            android:textColor="#99A3B2"
            android:textSize="24sp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Suggestion chips (same spirit as in-app composer) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/overlay_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingRight="4dp">

            <TextView
                android:id="@+id/chip_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:background="@drawable/eta_chip_bg"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Turn on flashlight"
                android:textColor="#E8EEF7"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:background="@drawable/eta_chip_bg"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Open WhatsApp"
                android:textColor="#E8EEF7"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:background="@drawable/eta_chip_bg"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Where am I?"
                android:textColor="#E8EEF7"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/eta_chip_bg"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Set a timer"
                android:textColor="#E8EEF7"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Status -->
    <TextView
        android:id="@+id/overlay_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/overlay_hint"
        android:textColor="#8B95A8"
        android:textSize="12sp" />

    <!-- Composer row: input + mic + send -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:background="@drawable/eta_composer_bg"
        android:padding="6dp">

        <EditText
            android:id="@+id/overlay_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:background="@android:color/transparent"
            android:hint="What do you want to do?"
            android:textColorHint="#668B95A8"
            android:textColor="#F7F9FC"
            android:textSize="15sp"
            android:paddingLeft="12dp"
            android:paddingRight="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="actionSend"
            android:maxLines="4" />

        <TextView
            android:id="@+id/overlay_mic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="4dp"
            android:gravity="center"
            android:text="🎤"
            android:textSize="18sp"
            android:background="@drawable/eta_mic_bg"
            android:contentDescription="Speak" />

        <TextView
            android:id="@+id/overlay_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:gravity="center"
            android:text="↑"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/eta_send_bg"
            android:contentDescription="Send" />
    </LinearLayout>
</LinearLayout>
